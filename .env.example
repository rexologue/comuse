#################
# LLM (OpenAI-compatible): on start these models become providers `default…` and take the
# empty roles (docs/LLM.md); LLM_MODEL empty = add providers through POST /llm/providers
#################

LLM_BASE_URL=http://llm-host:8000/v1 # any OpenAI-compatible /v1 with tool calling
# empty = no Authorization header
LLM_API_KEY=
LLM_MODEL=qwen3:30b # one model for everything…
LLM_MODEL_CHAT=gpt-oss:120b # …optional override: the chat agent and the compiler (multi-step)
# …optional override: llm.* tools, template markup (single calls)
LLM_MODEL_INSTRUCT=
LLM_MODEL_EMBED=bge-m3 # empty = no tool ranking, the agent sees all tools
# embeddings server if not LLM_BASE_URL (e.g. http://llm-host:8000/v1)
LLM_EMBED_BASE_URL=
# key for that server; empty = LLM_API_KEY on the same server, none on another
LLM_EMBED_API_KEY=

#################
# FOLDERS
#################

WORKSPACE_DIR=workspace # the user's documents (e.g. C:/Users/<name>/Documents); set here = locked, empty = PATCH /settings
DATA_DIR=data # app.db, templates, generated files

#################
# PORTS
#################

# empty = single: every service in one process; multi = a process each
RUN_MODE=
# empty = a free port picked on the first start and kept in DATA_DIR/runtime.json; the other services take any free port
MAIN_PORT=

#################
# TOKENS
#################

# empty = main makes one on the first start and keeps it in DATA_DIR/api_token
API_TOKEN=
# Host headers main answers (against DNS rebinding); empty = 127.0.0.1,localhost; * = no check
ALLOWED_HOSTS=
# browser origins allowed by CORS (comma-separated); empty = none
ALLOWED_ORIGINS=
# empty = launcher generates one per start
INTERNAL_TOKEN=

#################
# SECRETS
#################

KEYRING_BACKEND=system # system (Credential Manager / Keychain / Secret Service) or file
# required for KEYRING_BACKEND=file
KEYRING_PASSWORD=

#################
# SETTINGS (docs/SETTINGS.md: changed through PATCH /settings; set here = locked)
#################

# RETENTION_DAYS=15
# AGENT_MAX_ITERATIONS=16
# AGENT_TOOLS_TOP_K=24
# AGENT_HISTORY_MESSAGES=40
# COMPILER_MAX_ATTEMPTS=3
# TOOL_TIMEOUT_SEC=300
# LLM_TIMEOUT_SEC=300
# LLM_MAX_RETRIES=2
# LLM_NO_PROXY=true # ignore HTTP(S)_PROXY, like curl --noproxy '*'
# LLM_CHAT_REASONING_EFFORT=low # low | medium | high for reasoning chat models; empty = not sent

LOG_LEVEL=INFO
