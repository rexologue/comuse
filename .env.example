#################
# LLM (OpenAI-compatible)
#################

LLM_BASE_URL=http://llm-host:8000/v1 # any OpenAI-compatible /v1 with tool calling
LLM_API_KEY= # empty = no Authorization header
LLM_NO_PROXY=true # ignore HTTP(S)_PROXY, like curl --noproxy '*'
LLM_MODEL=qwen3:30b # one model for everything…
LLM_MODEL_CHAT=gpt-oss:120b # …optional override: the chat agent and the compiler (multi-step)
LLM_MODEL_INSTRUCT= # …optional override: llm.* tools, template markup (single calls)
LLM_CHAT_REASONING_EFFORT=low # low | medium | high for reasoning models; empty = not sent
LLM_MODEL_EMBED=bge-m3 # empty = no tool ranking, the agent sees all tools
LLM_EMBED_BASE_URL= # embeddings server if not LLM_BASE_URL (e.g. http://llm-host:8000/v1)
LLM_EMBED_API_KEY= # key for that server; empty = none

#################
# FOLDERS
#################

WORKSPACE_DIR=workspace # the user's documents; on Windows e.g. C:/Users/<name>/Documents
DATA_DIR=data # app.db, templates, generated files

#################
# TOKENS
#################

API_TOKEN= # empty = the external API is open (local use)
INTERNAL_TOKEN= # empty = launcher generates one per start

#################
# SECRETS
#################

KEYRING_BACKEND=system # system (Credential Manager / Keychain / Secret Service) or file
KEYRING_PASSWORD= # required for KEYRING_BACKEND=file

LOG_LEVEL=INFO
