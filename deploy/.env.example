###################
# DEPLOY SETTINGS #
###################

AGENT_DEPLOY_PORT=8000
AGENT_DEPLOY_HOST=127.0.0.1 # 0.0.0.0 to expose main on the network (set API_TOKEN then)
AGENT_DEPLOY_IMAGE=fintech2026-agent:0.1.0
AGENT_DEPLOY_CONTAINER_PREFIX=fintech2026
AGENT_DEPLOY_WORKSPACE_PATH=/path/to/the/users/documents # mounted as /workspace

# Container time zone: cron triggers fire in it.
TZ=Europe/Moscow

########################
# APPLICATION SETTINGS #
########################

# LLM (any OpenAI-compatible /v1 with tool calling)
LLM_BASE_URL=http://llm-host:8000/v1
LLM_API_KEY= # empty = no Authorization header
LLM_NO_PROXY=true
LLM_MODEL=qwen3:30b # one model for everything…
LLM_MODEL_CHAT=gpt-oss:120b # …optional override: chat agent and compiler
LLM_MODEL_INSTRUCT= # …optional override: llm.* tools, template markup
LLM_CHAT_REASONING_EFFORT=medium # low | medium | high; empty = not sent
LLM_MODEL_EMBED=bge-m3 # empty = no tool ranking
LLM_EMBED_BASE_URL= # embeddings server if not LLM_BASE_URL (e.g. http://llm-host:8000/v1)
LLM_EMBED_API_KEY= # key for that server; empty = none

# Tokens
API_TOKEN= # empty = external API open; set it when AGENT_DEPLOY_HOST is not loopback
INTERNAL_TOKEN=change-me # shared by all containers, must be set

# Secrets (encrypted file inside the data volume)
KEYRING_PASSWORD=change-me

LOG_LEVEL=INFO
