###################
# DEPLOY SETTINGS #
###################

AGENT_DEPLOY_PORT=8000
AGENT_DEPLOY_HOST=127.0.0.1 # 0.0.0.0 to expose main on the network
AGENT_DEPLOY_ALLOWED_HOSTS=127.0.0.1,localhost # names clients reach main by (Host header); add the server's name when exposed; * = no check
AGENT_DEPLOY_IMAGE=fintech2026-agent:0.1.0
AGENT_DEPLOY_CONTAINER_PREFIX=fintech2026
AGENT_DEPLOY_WORKSPACE_PATH=/path/to/the/users/documents # mounted as /workspace

# Container time zone: cron triggers fire in it.
TZ=Europe/Moscow

########################
# APPLICATION SETTINGS #
########################

# LLM (any OpenAI-compatible /v1 with tool calling). On start these models become providers
# `default…` and take the empty roles; LLM_MODEL empty = add providers through POST /llm/providers
LLM_BASE_URL=http://llm-host:8000/v1
LLM_API_KEY= # empty = no Authorization header
LLM_MODEL=qwen3:30b # one model for everything…
LLM_MODEL_CHAT=gpt-oss:120b # …optional override: chat agent and compiler
LLM_MODEL_INSTRUCT= # …optional override: llm.* tools, template markup
LLM_MODEL_EMBED=bge-m3 # empty = no tool ranking
LLM_EMBED_BASE_URL= # embeddings server if not LLM_BASE_URL (e.g. http://llm-host:8000/v1)
LLM_EMBED_API_KEY= # key for that server; empty = LLM_API_KEY on the same server, none on another

# Tokens
API_TOKEN= # empty = main makes one on the first start: /data/api_token in the data volume
ALLOWED_ORIGINS= # browser origins allowed by CORS (comma-separated); empty = none
INTERNAL_TOKEN=change-me # shared by all containers, must be set

# Secrets (encrypted file inside the data volume)
KEYRING_PASSWORD=change-me

# Settings (docs/SETTINGS.md): changed through PATCH /settings; set here = locked
# RETENTION_DAYS=15
# AGENT_MAX_ITERATIONS=16
# AGENT_TOOLS_TOP_K=24
# AGENT_HISTORY_MESSAGES=40
# COMPILER_MAX_ATTEMPTS=3
# TOOL_TIMEOUT_SEC=300
# LLM_TIMEOUT_SEC=300
# LLM_MAX_RETRIES=2
# LLM_NO_PROXY=true # ignore HTTP(S)_PROXY, like curl --noproxy '*'
# LLM_CHAT_REASONING_EFFORT=low # low | medium | high for reasoning chat models; empty = not sent

LOG_LEVEL=INFO
